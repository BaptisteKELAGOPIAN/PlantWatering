# Port d'écoute du serveur Node.js
PORT=3001

# Connexion PostgreSQL (Docker local ou Railway)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plantwatering?schema=public"

# URL du frontend Vercel autorisé (Whitelist CORS & WebSocket)
FRONTEND_URL="https://plant-watering-alpha.vercel.app"

# Mot de passe Administrateur pour déverrouiller les actions d'arrosage et réglages
ADMIN_PASSWORD="votre_mot_de_passe_admin_secret"

# Environnement (development ou production)
NODE_ENV=development
