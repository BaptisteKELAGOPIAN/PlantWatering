{
  "name": "plant-watering-backend",
  "version": "1.0.0",
  "description": "Backend API and WebSocket server for the plant watering project",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && prisma db push && tsc",
    "start": "node dist/index.js",
